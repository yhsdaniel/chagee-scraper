{
  "name": "webapp-scraper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env IS_DEV=true electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build": "npm run build:react && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.you.scraperapp",
    "productName": "Chagee Scraper App",
    "files": [
      "electron/**",
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "python/",
        "to": "python/"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "yhsdaniel",
      "repo": "https://github.com/yhsdaniel/webapp-scraper.git"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}